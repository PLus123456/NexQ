{
  "version": 1,
  "description": "Endpoint address and header rules, run by both src-tauri/src/net/endpoint.rs and src/lib/endpoint.test.ts. Error cases name the code; missing_scheme cases also give the suggestion and unsupported_scheme cases the scheme. The invalid_url detail text is not compared. Optional fields: warnings (default []), prefix (default \"/v1\"), custom (default []).",
  "join": [
    { "name": "OpenAI", "base": "https://api.openai.com/v1", "path": "/chat/completions", "url": "https://api.openai.com/v1/chat/completions" },
    { "name": "trailing slash", "base": "https://api.openai.com/v1/", "path": "/chat/completions", "url": "https://api.openai.com/v1/chat/completions" },
    { "name": "several trailing slashes", "base": "https://api.openai.com/v1///", "path": "/models", "url": "https://api.openai.com/v1/models" },
    { "name": "surrounding spaces, Zhipu /api/paas/v4", "base": "  https://open.bigmodel.cn/api/paas/v4  ", "path": "/chat/completions", "url": "https://open.bigmodel.cn/api/paas/v4/chat/completions" },
    { "name": "Volcengine /api/v3", "base": "https://ark.cn-beijing.volces.com/api/v3", "path": "/chat/completions", "url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions" },
    { "name": "LAN Whisper server", "base": "http://192.168.1.10:8000/v1", "path": "/audio/transcriptions", "url": "http://192.168.1.10:8000/v1/audio/transcriptions" },
    { "name": "host only: /v1 is not added", "base": "http://192.168.1.10:8000", "path": "/audio/transcriptions", "url": "http://192.168.1.10:8000/audio/transcriptions", "warnings": ["no_version_prefix"] },
    { "name": "host with root slash", "base": "https://api.example.com/", "path": "/models", "url": "https://api.example.com/models", "warnings": ["no_version_prefix"] },
    { "name": "Azure: query kept, path appended before it", "base": "https://x.openai.azure.com/openai/deployments/gpt4o?api-version=2024-10-21", "path": "/chat/completions", "url": "https://x.openai.azure.com/openai/deployments/gpt4o/chat/completions?api-version=2024-10-21" },
    { "name": "Azure full URL pasted", "base": "https://x.openai.azure.com/openai/deployments/gpt4o/chat/completions?api-version=2024-10-21", "path": "/chat/completions", "url": "https://x.openai.azure.com/openai/deployments/gpt4o/chat/completions?api-version=2024-10-21", "warnings": ["already_full"] },
    { "name": "full chat URL pasted", "base": "https://gw.example.com/llm/chat/completions", "path": "/chat/completions", "url": "https://gw.example.com/llm/chat/completions", "warnings": ["already_full"] },
    { "name": "full chat URL with trailing slash", "base": "https://gw.example.com/llm/chat/completions/", "path": "/chat/completions", "url": "https://gw.example.com/llm/chat/completions", "warnings": ["already_full"] },
    { "name": "full embeddings URL", "base": "http://10.0.0.5:8000/v1/embeddings", "path": "/embeddings", "url": "http://10.0.0.5:8000/v1/embeddings", "warnings": ["already_full"] },
    { "name": "path is exactly the suffix", "base": "http://10.0.0.5:8000/rerank", "path": "/rerank", "url": "http://10.0.0.5:8000/rerank", "warnings": ["already_full"] },
    { "name": "suffix matches whole segments only", "base": "https://h.example/mymodels", "path": "/models", "url": "https://h.example/mymodels/models" },
    { "name": "suffix match is case-sensitive", "base": "https://h.example/v1/Models", "path": "/models", "url": "https://h.example/v1/Models/models" },
    { "name": "fragment dropped", "base": "https://h.example/v1#frag", "path": "/models", "url": "https://h.example/v1/models" },
    { "name": "empty query dropped", "base": "https://h.example/v1?", "path": "/models", "url": "https://h.example/v1/models" },
    { "name": "DashScope embeddings", "base": "https://dashscope.aliyuncs.com/compatible-mode/v1", "path": "/embeddings", "url": "https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings" },
    { "name": "Gemini OpenAI-compatible models", "base": "https://generativelanguage.googleapis.com/v1beta/openai", "path": "/models", "url": "https://generativelanguage.googleapis.com/v1beta/openai/models" },
    { "name": "SiliconFlow rerank", "base": "https://api.siliconflow.cn/v1", "path": "/rerank", "url": "https://api.siliconflow.cn/v1/rerank" },
    { "name": "path without leading slash", "base": "https://api.openai.com/v1", "path": "models", "url": "https://api.openai.com/v1/models" },
    { "name": "uppercase scheme and host, default port", "base": "HTTPS://API.EXAMPLE.COM:443/v1", "path": "/chat/completions", "url": "https://api.example.com/v1/chat/completions" },
    { "name": "explicit non-default port kept", "base": "https://h.example:8443/v1", "path": "/models", "url": "https://h.example:8443/v1/models" },
    { "name": "Ollama OpenAI-compatible on localhost", "base": "http://localhost:11434/v1", "path": "/chat/completions", "url": "http://localhost:11434/v1/chat/completions" },
    { "name": "IPv6 literal", "base": "http://[::1]:8000/v1", "path": "/models", "url": "http://[::1]:8000/v1/models" },
    { "name": "userinfo kept", "base": "https://user:pass@h.example/v1", "path": "/models", "url": "https://user:pass@h.example/v1/models" },
    { "name": "empty path: the base itself", "base": "http://192.168.1.10:8000/v1/", "path": "", "url": "http://192.168.1.10:8000/v1" },
    { "name": "empty path on a host only", "base": "http://192.168.1.10:8000", "path": "", "url": "http://192.168.1.10:8000/", "warnings": ["no_version_prefix"] },
    { "name": "error: empty", "base": "", "path": "/chat/completions", "error": "empty" },
    { "name": "error: whitespace only", "base": "   ", "path": "/chat/completions", "error": "empty" },
    { "name": "error: missing scheme", "base": "api.openai.com/v1", "path": "/chat/completions", "error": "missing_scheme", "suggestion": "https://api.openai.com/v1" },
    { "name": "error: missing scheme, localhost", "base": "localhost:11434", "path": "/chat/completions", "error": "missing_scheme", "suggestion": "http://localhost:11434" },
    { "name": "error: missing scheme, LAN address", "base": "192.168.1.10:8000/v1", "path": "/audio/transcriptions", "error": "missing_scheme", "suggestion": "http://192.168.1.10:8000/v1" },
    { "name": "error: ftp", "base": "ftp://example.com", "path": "/models", "error": "unsupported_scheme", "scheme": "ftp" },
    { "name": "error: scheme only", "base": "http://", "path": "/models", "error": "invalid_url" }
  ],
  "normalize": [
    { "name": "trailing slash stripped", "input": "https://api.openai.com/v1/", "base": "https://api.openai.com/v1", "path_empty": false },
    { "name": "host only", "input": "http://192.168.1.10:8000", "base": "http://192.168.1.10:8000", "path_empty": true },
    { "name": "host with root slash", "input": "http://192.168.1.10:8000/", "base": "http://192.168.1.10:8000", "path_empty": true },
    { "name": "case, spaces and slashes normalized", "input": "  HTTPS://Open.BigModel.cn/api/paas/v4//  ", "base": "https://open.bigmodel.cn/api/paas/v4", "path_empty": false },
    { "name": "query kept, fragment dropped", "input": "https://x.openai.azure.com/openai/deployments/gpt4o/?api-version=2024-10-21#top", "base": "https://x.openai.azure.com/openai/deployments/gpt4o?api-version=2024-10-21", "path_empty": false },
    { "name": "empty query on a host only", "input": "https://h.example/?", "base": "https://h.example", "path_empty": true },
    { "name": "query on a host only", "input": "https://h.example?x=1", "base": "https://h.example?x=1", "path_empty": true },
    { "name": "userinfo and port kept", "input": "https://user:pa%20ss@h.example:8443/v1", "base": "https://user:pa%20ss@h.example:8443/v1", "path_empty": false },
    { "name": "default http port dropped", "input": "http://h.example:80/v1", "base": "http://h.example/v1", "path_empty": false },
    { "name": "IPv6 literal", "input": "http://[::1]:11434/", "base": "http://[::1]:11434", "path_empty": true },
    { "name": "internationalized host", "input": "https://例子.测试/v1", "base": "https://xn--fsqu00a.xn--0zwm56d/v1", "path_empty": false },
    { "name": "space in the path encoded", "input": "https://h.example/my models/v1", "base": "https://h.example/my%20models/v1", "path_empty": false },
    { "name": "backslashes read as slashes", "input": "https://h.example\\v1\\", "base": "https://h.example/v1", "path_empty": false },
    { "name": "dot segments resolved", "input": "https://h.example/v1/../v2/", "base": "https://h.example/v2", "path_empty": false },
    { "name": "ideographic spaces trimmed", "input": "　https://api.openai.com/v1　", "base": "https://api.openai.com/v1", "path_empty": false },
    { "name": "BOM and NEL trimmed", "input": "﻿https://api.openai.com/v1\u0085", "base": "https://api.openai.com/v1", "path_empty": false },
    { "name": "error: tabs and newlines only", "input": "\t\n", "error": "empty" },
    { "name": "error: bare host", "input": "api.example.com", "error": "missing_scheme", "suggestion": "https://api.example.com" },
    { "name": "error: port 443 suggests https", "input": "api.example.com:443/v1", "error": "missing_scheme", "suggestion": "https://api.example.com:443/v1" },
    { "name": "error: another port suggests http", "input": "example.com:8443/v1", "error": "missing_scheme", "suggestion": "http://example.com:8443/v1" },
    { "name": "error: .local host", "input": "mybox.local/v1", "error": "missing_scheme", "suggestion": "http://mybox.local/v1" },
    { "name": "error: .localhost host", "input": "gpu.localhost/v1", "error": "missing_scheme", "suggestion": "http://gpu.localhost/v1" },
    { "name": "error: case kept in the suggestion", "input": "LocalHost:1234", "error": "missing_scheme", "suggestion": "http://LocalHost:1234" },
    { "name": "error: loopback IPv4", "input": "127.0.0.1/v1", "error": "missing_scheme", "suggestion": "http://127.0.0.1/v1" },
    { "name": "error: 10/8 is private", "input": "10.1.2.3/v1", "error": "missing_scheme", "suggestion": "http://10.1.2.3/v1" },
    { "name": "error: 172.16/12 is private", "input": "172.20.0.3/v1", "error": "missing_scheme", "suggestion": "http://172.20.0.3/v1" },
    { "name": "error: 172.32 is public", "input": "172.32.0.1/v1", "error": "missing_scheme", "suggestion": "https://172.32.0.1/v1" },
    { "name": "error: a digits-first hostname is not an IP", "input": "10.example.com/v1", "error": "missing_scheme", "suggestion": "https://10.example.com/v1" },
    { "name": "error: IPv6 literal", "input": "[::1]:8080/v1", "error": "missing_scheme", "suggestion": "http://[::1]:8080/v1" },
    { "name": "error: userinfo skipped when guessing", "input": "user:pw@api.example.com/v1", "error": "missing_scheme", "suggestion": "https://user:pw@api.example.com/v1" },
    { "name": "error: userinfo with a private IPv4", "input": "user:pw@10.0.0.2/v1", "error": "missing_scheme", "suggestion": "http://user:pw@10.0.0.2/v1" },
    { "name": "error: a later :// is not a scheme", "input": "localhost:11434/api?next=http://x", "error": "missing_scheme", "suggestion": "http://localhost:11434/api?next=http://x" },
    { "name": "error: websocket scheme", "input": "ws://h.example/v1", "error": "unsupported_scheme", "scheme": "ws" },
    { "name": "error: scheme lowercased", "input": "FTP://example.com", "error": "unsupported_scheme", "scheme": "ftp" },
    { "name": "error: space in the host", "input": "https://exa mple.com/v1", "error": "invalid_url" },
    { "name": "error: empty host with a port", "input": "http://:8080/v1", "error": "invalid_url" },
    { "name": "error: port out of range", "input": "https://h.example:99999/v1", "error": "invalid_url" }
  ],
  "strip": [
    { "name": "full chat URL", "input": "https://gw.example.com/llm/chat/completions", "paths": ["/chat/completions", "/models"], "result": { "base": "https://gw.example.com/llm", "path": "/chat/completions" } },
    { "name": "suffix is the whole path", "input": "http://h:8000/chat/completions", "paths": ["/chat/completions"], "result": { "base": "http://h:8000", "path": "/chat/completions" } },
    { "name": "trailing slash", "input": "https://gw.example.com/llm/chat/completions/", "paths": ["/chat/completions"], "result": { "base": "https://gw.example.com/llm", "path": "/chat/completions" } },
    { "name": "query kept", "input": "https://x.openai.azure.com/openai/deployments/gpt4o/chat/completions?api-version=2024-10-21", "paths": ["/chat/completions"], "result": { "base": "https://x.openai.azure.com/openai/deployments/gpt4o?api-version=2024-10-21", "path": "/chat/completions" } },
    { "name": "double slash before the suffix", "input": "https://h.example/v1//models", "paths": ["/models"], "result": { "base": "https://h.example/v1", "path": "/models" } },
    { "name": "second path matches", "input": "http://10.0.0.5:8000/v1/embeddings", "paths": ["/chat/completions", "/embeddings"], "result": { "base": "http://10.0.0.5:8000/v1", "path": "/embeddings" } },
    { "name": "path given without leading slash", "input": "https://h.example/v1/models", "paths": ["models"], "result": { "base": "https://h.example/v1", "path": "models" } },
    { "name": "no match", "input": "https://api.openai.com/v1", "paths": ["/chat/completions", "/models"], "result": null },
    { "name": "whole segments only", "input": "https://h.example/mymodels", "paths": ["/models"], "result": null },
    { "name": "case-sensitive", "input": "https://h.example/v1/Chat/Completions", "paths": ["/chat/completions"], "result": null },
    { "name": "invalid input", "input": "api.openai.com/v1/chat/completions", "paths": ["/chat/completions"], "result": null }
  ],
  "add_version_prefix": [
    { "name": "host only", "base": "http://192.168.1.10:8000", "result": "http://192.168.1.10:8000/v1" },
    { "name": "root slash", "base": "http://192.168.1.10:8000/", "result": "http://192.168.1.10:8000/v1" },
    { "name": "query stays after the path", "base": " https://h.example?x=1 ", "result": "https://h.example/v1?x=1" },
    { "name": "existing path kept", "base": "https://h.example/openai", "result": "https://h.example/openai/v1" },
    { "name": "custom prefix", "base": "https://ark.example.com", "prefix": "/api/v3", "result": "https://ark.example.com/api/v3" },
    { "name": "prefix slashes normalized", "base": "https://h.example", "prefix": "v4/", "result": "https://h.example/v4" },
    { "name": "invalid input unchanged", "base": "localhost:11434", "result": "localhost:11434" },
    { "name": "blank input unchanged", "base": "  ", "result": "  " }
  ],
  "header_names": [
    { "header": "api-key", "valid": true },
    { "header": "X-Api-Key", "valid": true },
    { "header": "Authorization", "valid": true },
    { "header": "x_custom.header~1", "valid": true },
    { "header": "!#$%&'*+-.^_`|~", "valid": true },
    { "header": "", "valid": false },
    { "header": "bad name", "valid": false },
    { "header": " api-key", "valid": false },
    { "header": "x:y", "valid": false },
    { "header": "a/b", "valid": false },
    { "header": "(x)", "valid": false },
    { "header": "x\ty", "valid": false },
    { "header": "密钥", "valid": false }
  ],
  "headers": [
    { "name": "none ignores the secret", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": "sk-test", "headers": [] },
    { "name": "bearer", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "sk-test", "headers": [["Authorization", "Bearer sk-test"]] },
    { "name": "bearer ignores header name and prefix", "auth": { "mode": "bearer", "header_name": "api-key", "prefix": "Token" }, "secret": "sk-test", "headers": [["Authorization", "Bearer sk-test"]] },
    { "name": "secret trimmed", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "  sk-test\n", "headers": [["Authorization", "Bearer sk-test"]] },
    { "name": "bearer without secret: no header", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": null, "headers": [] },
    { "name": "bearer with blank secret: no header", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "   ", "headers": [] },
    { "name": "header mode without prefix", "auth": { "mode": "header", "header_name": "api-key", "prefix": "" }, "secret": "sk-test", "headers": [["api-key", "sk-test"]] },
    { "name": "header mode with prefix", "auth": { "mode": "header", "header_name": "Authorization", "prefix": " Token " }, "secret": "sk-test", "headers": [["Authorization", "Token sk-test"]] },
    { "name": "header name trimmed", "auth": { "mode": "header", "header_name": " x-api-key ", "prefix": "" }, "secret": "sk-test", "headers": [["x-api-key", "sk-test"]] },
    { "name": "header mode without secret: no header", "auth": { "mode": "header", "header_name": "api-key", "prefix": "" }, "secret": null, "headers": [] },
    { "name": "error: header mode, blank name", "auth": { "mode": "header", "header_name": "  ", "prefix": "" }, "secret": "sk-test", "error": "header_name_required" },
    { "name": "error: header mode, blank name, no secret", "auth": { "mode": "header", "header_name": "", "prefix": "" }, "secret": null, "error": "header_name_required" },
    { "name": "error: invalid auth header name", "auth": { "mode": "header", "header_name": "bad name", "prefix": "" }, "secret": "sk-test", "error": "invalid_header_name", "error_header": "bad name" },
    { "name": "error: line break inside the secret", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "sk-test\r\nX-Evil: 1", "error": "invalid_header_value", "error_header": "Authorization" },
    { "name": "custom headers after auth, in order, blank names skipped", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "sk-test", "custom": [{ "name": "X-Org", "value": "acme" }, { "name": "", "value": "ignored" }, { "name": "  ", "value": "ignored" }, { "name": "X-Trace", "value": "1" }], "headers": [["Authorization", "Bearer sk-test"], ["X-Org", "acme"], ["X-Trace", "1"]] },
    { "name": "custom headers without auth, trimmed", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": null, "custom": [{ "name": " X-Org ", "value": "  acme  " }], "headers": [["X-Org", "acme"]] },
    { "name": "custom header with an empty value", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": null, "custom": [{ "name": "X-Empty", "value": "" }], "headers": [["X-Empty", ""]] },
    { "name": "tab allowed in a value", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": null, "custom": [{ "name": "X-Tab", "value": "a\tb" }], "headers": [["X-Tab", "a\tb"]] },
    { "name": "error: invalid custom header name", "auth": { "mode": "bearer", "header_name": "", "prefix": "" }, "secret": "sk-test", "custom": [{ "name": "bad name", "value": "x" }], "error": "invalid_header_name", "error_header": "bad name" },
    { "name": "error: line break in a custom value", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": null, "custom": [{ "name": "X-Bad", "value": "a\r\nb" }], "error": "invalid_header_value", "error_header": "X-Bad" },
    { "name": "error: control character in a custom value", "auth": { "mode": "none", "header_name": "", "prefix": "" }, "secret": null, "custom": [{ "name": "X-Bad", "value": "a\u0000b" }], "error": "invalid_header_value", "error_header": "X-Bad" }
  ]
}
