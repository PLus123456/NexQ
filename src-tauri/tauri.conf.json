{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NexQ Plus",
  "mainBinaryName": "nexq-plus",
  "version": "2.41.3",
  "identifier": "com.plus.nexq",
  "build": {
    "beforeDevCommand": "node scripts/fetch-onnxruntime.mjs && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/fetch-onnxruntime.mjs && npm run build",
    "beforeBundleCommand": "node scripts/nsis-release-info.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "launcher",
        "title": "NexQ Plus",
        "width": 1200,
        "height": 820,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "NexQ Plus 悬浮窗",
        "width": 500,
        "height": 700,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "x": 50,
        "y": 50
      },
      {
        "label": "captions",
        "title": "NexQ Plus 字幕条",
        "url": "index.html?view=captions",
        "focusable": false,
        "width": 900,
        "height": 140,
        "minWidth": 320,
        "minHeight": 60,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "NexQ Plus"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./nsis-hooks.nsh",
        "template": "./nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMTUwMUZBQjgyQjIxQzUKUldURklTdTQrZ0VWUGVyUStJTzFFYXRUMXNHL00xdmw2V3dXWEV1UE5ZMDBXSXl3RVNoQjAxeHQK",
      "endpoints": [
        "https://github.com/PLus123456/NexQ-Plus/releases/latest/download/latest.json"
      ]
    }
  }
}
