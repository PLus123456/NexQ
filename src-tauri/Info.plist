<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for microphone capture (and for capturing the BlackHole virtual
	     input device). Without this key macOS terminates the app the first time it
	     tries to access audio input. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>NexQ Plus 需要使用麦克风，才能在通话中实时转写你的发言并提供 AI 协助。</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>NexQ Plus 需要录制所选输出设备播放的声音，才能转写通话中其他参会人的发言。</string>
	<!-- Web Speech in the webview uses the system speech recognizer, which needs
	     its own usage description. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NexQ Plus 使用系统语音识别（Web Speech）把你的发言实时转成文字。</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
